skills/*/data/
skills/*/inbox/_cand*.json
# 本地验证产物
hr_resume_run.json
hr_resume_err.txt
jd_run.json
jd_run.png
jd_report.html
*.db
*.sqlite
*.sqlite3
.secret
.env
.env.*
!.env.example
# 含明文 Key 的真实启动脚本：见 start_miniyuxi.example.bat
start_miniyuxi.bat
# MCP RuoYi Adapter 的 token vault 加密密钥（Fernet）——真实密钥，绝不入库
# 生成于 tools/.ruoyi_fernet_key（见 tools/mcp_ruoyi_adapter.py:_load_key）。
# 生产请改用环境变量 RUOYI_FERNET_KEY 注入持久密钥。
tools/.ruoyi_fernet_key
.ruoyi_fernet_key
run.bat

