# MiniYuxi 环境变量示例
# 用法：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会进入 git）
# Windows 用户也可直接复制 start_miniyuxi.example.bat 为 start_miniyuxi.bat 后填 Key。

# ---- LLM（OpenAI 兼容网关，SiliconFlow / DeepSeek / 通义 等皆可）----
LLM_API_KEY=你的LLM_API_KEY
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_TEMPERATURE=0.1

# ---- Embedding（向量检索；留空则仅用 BM25 全文检索）----
EMB_BASE_URL=https://api.siliconflow.cn/v1
EMB_MODEL=BAAI/bge-m3
EMB_DIM=1024

# ---- 企业级联网搜索后端（可选；火山引擎/豆包，中文更准）----
DOUBAO_API_KEY=你的DOUBAO_API_KEY
DOUBAO_BASE_URL=https://open.feedcoopapi.com
SEARCH_BACKEND=doubao

# ---- 服务监听 ----
MINIYUXI_HOST=127.0.0.1
MINIYUXI_PORT=8801

# 生产环境务必显式设置强随机值（run.py 也会在首次启动时自动生成并写入 data/.secret）
MINIYUXI_SECRET=
